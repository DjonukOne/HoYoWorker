# Среда разработки (Виртуальное окружение)
venv/
env/
.venv/

# Кэш Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Артефакты сборки PyInstaller (exe файлы)
build/
dist/
*.spec

# IDE (настройки редакторов кода, например VSCode или PyCharm)
.idea/
.vscode/

# Локальные базы данных и ключи (на случай, если тестировал локально)
*.db
*.key
ho_data.db
secret.key

# Системные файлы
.DS_Store
Thumbs.db